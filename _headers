# Cloudflare Pages response headers.
# Goal: new deployments appear on a normal refresh — never require Ctrl+Shift+R.

# The service worker MUST always be fetched fresh. If the edge or the browser
# serves a stale service-worker.js, the browser never detects a new deploy and
# the old worker keeps controlling the page. This is the #1 cause of a PWA that
# "won't update".
/service-worker.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

# HTML shells must revalidate every load so they always point at the current
# ?v= asset URLs. (no-cache = "may cache but must revalidate before use".)
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache

# Live data / API responses are never cached as "current".
/api/*
  Cache-Control: no-store
/api/google/*
  Cache-Control: no-store
  Referrer-Policy: no-referrer
/data/*.json
  Cache-Control: no-store

# The service worker serves content-versioned assets directly from its release
# cache. Uncontrolled browsers revalidate: this rule also covers unversioned
# images and scripts, so a blanket one-year HTTP lifetime is unsafe.
/assets/*
  Cache-Control: public, no-cache
/admin.html
  Cache-Control: no-store
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'
