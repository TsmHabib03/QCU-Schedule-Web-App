# Cloudflare Pages local/deployment secrets for Google Integration.
# Copy to .dev.vars for `wrangler pages dev .`; never commit .dev.vars.

GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
# Use a random value of at least 32 characters. This encrypts the HttpOnly session cookie.
GOOGLE_SESSION_SECRET="replace-with-a-long-random-secret"

# Leave empty for local development so the redirect URI follows the request
# origin (http://127.0.0.1:8788 for `npm run dev`, :8790 for `npm run
# dev:wrangler`). In production this is pinned in wrangler.toml, because Google
# matches redirect URIs exactly and every Cloudflare Pages deployment otherwise
# presents a different hostname.
GOOGLE_PUBLIC_ORIGIN=

# --- Google Sheets persistence (optional locally, required in production) ---
# Leave both blank for local development: the repository then keeps student data
# in memory for the lifetime of one request, which is fine for `npm run dev` and
# is why `npm run dev` needs no spreadsheet.
#
# Set both to persist to the Google Sheets workbook:
#   1. Open the workbook > Extensions > Apps Script, paste setup-database.gs
#   2. Run setupDatabase(), then seedCatalogData()
#   3. Project Settings > Script properties > add APPS_SCRIPT_SECRET
#   4. Deploy > New deployment > Web app (Execute as: Me, Access: Anyone)
#   5. Put the /exec URL in APPS_SCRIPT_URL and the same secret here
# The secret signs every request (HMAC-SHA256); the two values must match
# exactly or Apps Script rejects the call with UNAUTHENTICATED.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
